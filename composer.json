{
    "name":"bright-cloud-studio/contao-ce-chart",
    "description":"Integrates Chart.js into Contao using custom content elements.",
    "keywords": ["contao", "content element", "bright", "cloud", "studio", "chartjs", "chart"],
    "type": "contao-bundle",
    "homepage": "https://brightcloudstudio.com/",
    "license": "MIT",
    "authors":[
        {
            "name": "Bright Cloud Studio",
            "homepage": "https://brightcloudstudio.com",
            "email": "mark@brightcloudstudio.com",
            "role": "Developer"
        }
    ],
    "support":{
        "issues": "https://github.com/bright-cloud-studio/contao-ce-chart/issues",
        "source": "https://github.com/bright-cloud-studio/contao-ce-chart"
    },
    "require":{
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "menatwork/contao-multicolumnwizard-bundle": "^3.7"
    },
    "extra":{
        "contao-manager-plugin": "Bcs\\ChartBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Bcs\\ChartBundle\\": "src/"
        }
    }
}
